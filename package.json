{
  "name": "jiancai-ocr",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "鉴裁 · 答题卡识别系统（Web 管理端 + 移动端，对接 /api/v1）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite preview --host",
    "typecheck": "tsc -b",
    "smoke": "node scripts/smoke.mjs",
    "templates": "node scripts/emit-card-templates.mjs",
    "deploy:pages": "wrangler pages deploy dist --project-name ocr-web --branch main --commit-dirty=true"
  },
  "dependencies": {
    "antd-mobile": "^5.43.0",
    "framer-motion": "^14.14.0",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-moveable": "^0.56.0",
    "react-router-dom": "^7.9.4",
    "selecto": "^1.26.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
